# ==============================================================================
# SUPABASE CONFIGURATION
# Masukkan Project URL dan anon / service_role key dari dashboard Supabase Anda:
# Project Settings -> API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# GOOGLE SPREADSHEETS URL (SOURCE DATA)
# ==============================================================================
GOOGLE_SHEET_JABO_URL=https://docs.google.com/spreadsheets/d/1j2gO8I1I-93cvbR5zHZTg87xImqL-99tv3jiIzP-n_o/export?format=csv&gid=0
GOOGLE_SHEET_KALBAR_URL=https://docs.google.com/spreadsheets/d/1j2gO8I1I-93cvbR5zHZTg87xImqL-99tv3jiIzP-n_o/export?format=csv&gid=1713589401

# Google Spreadsheet: Request Order (RO) Distribusi per Wilayah
GOOGLE_SHEET_RO_JABO_URL=https://docs.google.com/spreadsheets/d/15Ir0Rc9y7N8qMKJWMoPFPWD0TX_bhQF-S2F6CMCtSIM/export?format=csv&gid=1529640038
GOOGLE_SHEET_RO_KALBAR_URL=https://docs.google.com/spreadsheets/d/15Ir0Rc9y7N8qMKJWMoPFPWD0TX_bhQF-S2F6CMCtSIM/export?format=csv&gid=0

# Google Spreadsheet: Kelola Item & Master Aset
GOOGLE_SHEET_MASTER_ASSET_URL=https://docs.google.com/spreadsheets/d/1ie4cLxARxPHDSwH-rERxYbxbmk99mQPMHy2wJUOgpIQ/export?format=csv&gid=529914403

# Auto Sync Interval (dalam menit, opsional)
SYNC_INTERVAL_MINUTES

# Bucket Supabase Storage untuk bukti foto & tanda tangan (opsional)
# PROOF_BUCKET=delivery-proofs

# ==============================================================================
# RETENSI AUDIT LOG
# Log lebih tua dari 7 hari dihapus otomatis oleh /api/audit/cleanup.
# CRON_SECRET wajib diisi di Vercel agar cron dapat memanggil endpoint.
# ==============================================================================
# CRON_SECRET=isi-dengan-string-acak-panjang
# AUDIT_LOG_RETENTION_DAYS=7
# Set ke "off" untuk mematikan sapuan oportunistik saat membuka audit log.
# AUDIT_LOG_AUTO_PURGE=off

# ==============================================================================
# SYNC ENGINE
# SYNC_TOKEN wajib untuk webhook Apps Script (header x-sync-token).
# CRON_SECRET dipakai Vercel Cron (Authorization: Bearer <CRON_SECRET>).
# ==============================================================================
# SYNC_TOKEN=isi-token-acak-panjang
# CRON_SECRET=isi-secret-acak-panjang
# SYNC_WEBHOOK_DEBOUNCE_MINUTES=5
